{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hyper",
  "version": "1.0.2",
  "identifier": "com.hyper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Hyper",
        "width": 480,
        "height": 680,
        "minWidth": 480,
        "minHeight": 680,
        "maxWidth": 900,
        "maxHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/yt-dlp",
      "bin/yt-dlp.exe"
    ]
  }
}